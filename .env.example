# ============================================================
# Behtan — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in your Supabase project under Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Gemini API (server-side only — set as Supabase secret) ───
# This key is NEVER used in the browser. It lives only in the
# Supabase Edge Function environment.
# Set it with: supabase secrets set GEMINI_API_KEY=your-key
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=  ← do NOT put this in VITE_ prefix

# ── Auth abstraction ─────────────────────────────────────────
# Current production driver. A domestic driver can be added later without
# changing PhoneAuth/useAuth.
VITE_AUTH_DRIVER=supabase

# ── Supabase Send SMS Hook (server-side secrets only) ────────
# Configure these in Supabase Edge Function Secrets, NOT in the browser .env.
# The hook secret is generated/configured under Authentication > Hooks.
# SEND_SMS_HOOK_SECRETS=v1,whsec_<base64-secret>
# SMS_PROVIDER=generic_http
# SMS_PROVIDER_URL=https://your-iranian-sms-provider.example/api/send
# SMS_PROVIDER_METHOD=POST
# SMS_PROVIDER_BODY_FORMAT=json              # json | form
# SMS_PROVIDER_PHONE_FORMAT=iran_local       # iran_local | e164 | digits
# SMS_PROVIDER_PAYLOAD_MODE=message          # message | template
# SMS_PROVIDER_API_KEY=<server-only-api-key>
# SMS_PROVIDER_API_KEY_MODE=header            # header | bearer | query | none
# SMS_PROVIDER_API_KEY_NAME=x-api-key
# SMS_PROVIDER_PHONE_FIELD=mobile
# SMS_PROVIDER_MESSAGE_FIELD=message
# SMS_PROVIDER_OTP_FIELD=code
# SMS_PROVIDER_TEMPLATE_FIELD=templateId
# SMS_PROVIDER_TEMPLATE_ID=<optional-template-id>
# SMS_PROVIDER_SENDER_FIELD=sender
# SMS_PROVIDER_SENDER=<optional-sender-line>
# SMS_PROVIDER_EXTRA_HEADERS_JSON={}
# SMS_PROVIDER_EXTRA_BODY_JSON={}
# SMS_PROVIDER_SUCCESS_STATUSES=200,201
# SMS_PROVIDER_SUCCESS_JSON_PATH=status
# SMS_PROVIDER_SUCCESS_VALUES=OK,1,200
# SMS_PROVIDER_EXTERNAL_ID_JSON_PATH=data.messageId
# SMS_PROVIDER_TIMEOUT_MS=3500
# SMS_MESSAGE_TEMPLATE=کد ورود به به‌تن: {{otp}}
