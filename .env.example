# ============================================================
# Behtan — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in your Supabase project under Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Gemini API (server-side only — set as Supabase secret) ───
# This key is NEVER used in the browser. It lives only in the
# Supabase Edge Function environment.
# Set it with: supabase secrets set GEMINI_API_KEY=your-key
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=  ← do NOT put this in VITE_ prefix
# Optional comma-separated preview origins allowed to call the body-scan Edge Function.
# Production behtan.fit origins and local Vite origins are already allowed in code.
# BODY_SCAN_ALLOWED_ORIGINS=https://your-preview.vercel.app

# ── Auth abstraction ─────────────────────────────────────────
# Current production driver. A domestic driver can be added later without
# changing PhoneAuth/useAuth.
VITE_AUTH_DRIVER=supabase

# Public Cloudflare Turnstile site key. Configure its matching secret key in
# Supabase Authentication > Bot and Abuse Protection. This is not a secret.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── SMS.ir + Supabase Send SMS Hook (server-side secrets) ────
# Set these with `supabase secrets set`; never add real values to .env/VITE_*.
# SEND_SMS_HOOK_SECRETS=v1,whsec_<base64-secret>
# SMS_IR_API_KEY=<server-only-api-key>
# SMS_IR_TEMPLATE_ID=<approved-numeric-template-id>
# SMS_IR_PARAMETER_NAME=Code

# ── ZarinPal payments (server-side secrets) ──────────────────
# ZARINPAL_MERCHANT_ID=<merchant-id>
# PAYMENT_SITE_URL=https://behtan.fit
# PAYMENT_RECONCILE_SECRET=<random-64-hex-characters>
